# TV Ambilight settings. install.sh copies this to ambilight.env - edit that file, then:
#   sudo systemctl restart tv-ambilight

# Your Android TV: IP address + ADB port (find the IP in the TV's network settings)
LEDLIVE_TV=192.168.1.50:5555

# Part of the TV model name (adb shell getprop ro.product.model). Used to find the TV again
# if your router gives it a new IP. Leave empty to accept the first Android TV found.
LEDLIVE_TV_MODEL=

# Your WLED controller: IP address or mDNS name (shown in the WLED app, e.g. wled-a1b2c3.local)
LEDLIVE_WLED=wled-a1b2c3.local

# LEDs on each side, clockwise from the TOP-LEFT corner: top,right,bottom,left
# Measure with: python3 tools/corner_test.py   (see README "Calibrate the LED layout")
LEDLIVE_LAYOUT=33,21,33,21

# Frame receiver: 0.0.0.0 = the grabber sends straight to this box over Wi-Fi (faster; only the TV's
# address is accepted). Use 127.0.0.1 if you set the grabber's host to 127.0.0.1 (ADB tunnel).
LEDLIVE_HP_BIND=0.0.0.0

# Web page: 0.0.0.0 = open from phones/laptops on your network, 127.0.0.1 = this computer only
LEDLIVE_WEB_BIND=0.0.0.0
LEDLIVE_WEB_PORT=8765
